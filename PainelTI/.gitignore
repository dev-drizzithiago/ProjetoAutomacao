__pycache__/
*.pyc

# Artefatos de build do PyInstaller (gerados por `pyinstaller ... main.py`)
build/
dist/
*.spec

# Contém senhas de Wi-Fi em texto simples — não deve ir para o controle de
# versão. Fica no disco para ser distribuído manualmente junto com o app.
config/wifi_profiles.json

# Efeito colateral do alterando_permissao/main.py legado (logging.basicConfig
# grava aqui quando o diretório de trabalho é PainelTI/).
logs.log

# Instaladores reais (.exe/.msi) não devem ir para o Git — são binários grandes
# e distribuídos manualmente junto com o app. config.json (mapeamento de
# argumentos silenciosos) pode ser versionado normalmente.
instaladores/*.exe
instaladores/*.msi
